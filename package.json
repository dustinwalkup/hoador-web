{
  "name": "hoador-web",
  "version": "0.3",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "type-check": "tsc --noEmit --skipLibCheck",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test e2e/auth",
    "test:e2e:ui": "playwright test e2e/auth --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "bun audit",
    "audit:fix": "bun audit --fix",
    "prepare": "husky",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:e2e": "tsx scripts/e2e-migrate.ts",
    "db:push:e2e": "tsx scripts/e2e-push.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "generate:rental-agreement": "tsx scripts/generate-rental-agreement-pdf.ts",
    "generate:service-agreement": "tsx scripts/generate-service-agreement-pdf.ts",
    "db:seed:users": "./src/db/seeds/users.ts",
    "seed": "tsx src/db/seeds/seed.ts",
    "seed:fix-listing-categories": "tsx src/db/seeds/fix-listing-categories.seed.ts",
    "seed:fix-service-categories": "tsx src/db/seeds/fix-service-categories.seed.ts",
    "seed:service-categories": "tsx src/db/seeds/service-categories.seed.ts",
    "seed:service-listings": "tsx src/db/seeds/service-listings.seed.ts",
    "seed:user": "tsx src/db/seeds/existing-user.seed.ts",
    "e2e:setup": "tsx scripts/e2e-setup.ts",
    "e2e:seed": "tsx src/db/seeds/e2e.seed.ts",
    "e2e:db:up": "docker compose up -d",
    "e2e:db:down": "docker compose down",
    "check-all": "bun run format && bun run test:run && bun run lint && bun run type-check",
    "check-all:save": "bun run type-check && bun run lint && bun run format && bun run test 2>&1 | tee check-results.txt",
    "ci": "bun run type-check && bun run lint && bun run test:ci && bun run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@faker-js/faker": "^10.4.0",
    "@hookform/resolvers": "^5.2.2",
    "@neondatabase/serverless": "^1.0.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10",
    "@stripe/connect-js": "^3.3.34",
    "@stripe/react-connect-js": "^3.3.33",
    "@stripe/react-stripe-js": "^6.1.0",
    "@stripe/stripe-js": "^9.0.1",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-query-devtools": "^5.95.2",
    "@vercel/blob": "^2.3.2",
    "@walkup/walkup-utils": "^1.1.0",
    "better-auth": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.38.0",
    "googleapis": "^171.4.0",
    "heic2any": "^0.0.4",
    "lucide-react": "^1.7.0",
    "next": "^16.2.1",
    "next-themes": "^0.4.6",
    "openai": "^6.33.0",
    "pino": "^10.3.1",
    "playwright": "^1.58.2",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.0",
    "react-svg-credit-card-payment-icons": "^5.1.2",
    "resend": "^6.10.0",
    "sanitize-html": "^2.17.2",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "stripe": "^22.0.0",
    "tailwind-merge": "^3.5.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@playwright/test": "^1.58.2",
    "@vitest/coverage-v8": "^4.1.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.1.0",
    "eslint-config-next": "^16.2.1",
    "happy-dom": "^20.8.9",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pg": "^8.20.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  }
}

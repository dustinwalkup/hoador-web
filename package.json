    "lucide-react": "^0.554.0",
    "next": "^15.5.0",
    "next-themes": "^0.4.6",
    "openai": "^5.11.0",
    "react": "^19.0.0",
    "react-day-picker": "^9.8.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.58.1",
    "react-intersection-observer": "^9.16.0",
    "resend": "^6.0.3",

# E2E test environment. Copy to .env.test and fill in values.
# The app must be started with E2E_TEST=1 when running auth E2E tests.

# Test database. Matches repo compose.yaml (docker compose up -d).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Must be "1" when running the app for E2E tests so the app uses the test DB and email capture.
E2E_TEST=1

# Better Auth (use a dedicated secret for test)
BETTER_AUTH_SECRET=your-e2e-auth-secret

# App URL; use the E2E port (e.g. 3001) so it does not conflict with dev (3000).
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Resend (can be a placeholder in E2E; emails are captured in-memory when E2E_TEST=1).
RESEND_API_KEY=your-resend-api-key

# Google OAuth (can be placeholders in E2E if using mocked OAuth).
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/callback/google

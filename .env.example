# Better Auth
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=http://localhost:3000

# Vercel Blob
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token

# Cron job authentication (required for Vercel Cron endpoints)
CRON_SECRET=your-cron-secret-here

# Neon DB
DATABASE_URL=postgresql://user:password@localhost:5432/database

# Google Auth
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Sheets New HOA Requests Form Responses
GOOGLE_SHEETS_CLIENT_ID=your-google-sheets-client-id
GOOGLE_SHEETS_CLIENT_SECRET=your-google-sheets-client-secret
GOOGLE_SHEETS_REFRESH_TOKEN=your-google-sheets-refresh-token
GOOGLE_SHEETS_ID=your-google-sheets-id


# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Internal API (rental agreement PDF generation worker)
INTERNAL_API_SECRET=your-internal-api-secret-here

# Stripe * TEST * Payment Confirmation URL
NEXT_PUBLIC_PAYMENT_CONFIRMATION_URL=http://localhost:3000/payment-test/confirmation

# Stripe * TEST * Publishable key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Open AI API
OPENAI_API_KEY=your-openai-api-key

# Open Cage Geocoding
OPENCAGE_API_KEY=your-opencage-api-key

# Operations alert email (receives critical payment failure alerts)
OPS_ALERT_EMAIL=ops@hoador.com

# Stale payout processing detection (minutes; default 60)
# Cron detects rentals stuck in payoutStatus 'processing' longer than this and sends ops alert
STALE_PROCESSING_THRESHOLD_MINUTES=60

# Resend SMTP Server
RESEND_API_KEY=your-resend-api-key

# Sentry
SENTRY_DSN=your-sentry-dsn
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
# Required for build-time source map upload + release creation (CI only)
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Serp pricing API 
SERP_API_KEY=your-serp-api-key

# Stripe TEST
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Vapid Keys (server uses both; client needs public key for push subscription)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Same value as VAPID_PUBLIC_KEY; required for browser push subscription (safe to expose)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
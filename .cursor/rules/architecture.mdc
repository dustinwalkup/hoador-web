## Data Mutation with Server Actions

- Use server actions for all data mutations (create, update, delete)
- Server actions should call DAL methods without authentication logic
- DAL methods handle authentication internally using `getCurrentUserId()` or `requireAuth()`
- Use `tryCatch` from `@walkup/walkup-utils` for consistent error handling
- Return structured results with success/error information
- Handle optimistic updates in client components
- Use `useActionState` for form submissions with server actions

```tsx
// ✅ Server action for data mutation
import { tryCatch } from "@walkup/walkup-utils";
import { ToolDAL } from "@/lib/dal/tool.dal";
import { revalidatePath } from "next/cache";

export async function createToolAction(prevState: any, formData: FormData) {
  const name = formData.get("name") as string;
  const description = formData.get("description") as string;
  const price = Number(formData.get("price"));

  const result = await tryCatch(
    () => ToolDAL.create({ name, description, price }),
    (error) => {
      console.error("Tool creation failed:", error);
      return { success: false, error: error.message };
    },
  );

  if (result.success) {
    revalidatePath("/dashboard/garage");
    return { success: true, toolId: result.data.id };
  }

  return { success: false, error: result.error };
}
```

```tsx
// ✅ DAL method with internal authentication
export class ToolDAL extends BaseDAL {
  static async create(data: CreateToolData) {
    const userId = await this.requireAuth();

    const result = await tryCatch(
      async () => {
        const tool = await db
          .insert(tools)
          .values({
            ...data,
            ownerId: userId,
            status: "active",
          })
          .returning();

        return tool[0];
      },
      (error) => {
        console.error("Database error:", error);
        throw new DatabaseError("Failed to create tool");
      },
    );

    return result;
  }

  static async update(id: string, data: UpdateToolData) {
    const userId = await this.requireAuth();

    const result = await tryCatch(
      async () => {
        const tool = await db
          .update(tools)
          .set(data)
          .where(and(eq(tools.id, id), eq(tools.ownerId, userId)))
          .returning();

        if (!tool[0]) {
          throw new UnauthorizedError("Tool not found or access denied");
        }

        return tool[0];
      },
      (error) => {
        console.error("Database error:", error);
        throw error;
      },
    );

    return result;
  }
}
```

```tsx
// ✅ Client component with optimistic updates
"use client";

import { useOptimistic, useTransition } from "react";
import { useActionState } from "react";
import { useToast } from "@/components/ui/use-toast";
import { createToolAction } from "@/lib/actions/create-tool";

export function CreateToolForm({ tools }: { tools: Tool[] }) {
  const { toast } = useToast();
  const [isPending, startTransition] = useTransition();

  const [optimisticTools, addOptimisticTool] = useOptimistic(
    tools,
    (state, newTool) => [...state, newTool],
  );

  const [state, formAction] = useActionState(
    async (prevState, formData) => {
      const name = formData.get("name") as string;

      // Add optimistic update
      addOptimisticTool({
        id: `temp-${Date.now()}`,
        name,
        status: "creating",
        createdAt: new Date(),
      });

      const result = await createToolAction(prevState, formData);

      if (!result.success) {
        toast({
          title: "Error",
          description: result.error || "Failed to create tool",
          variant: "destructive",
        });
      } else {
        toast({
          title: "Success",
          description: "Tool created successfully",
        });
      }

      return result;
    },
    { success: true },
  );

  return (
    <form action={formAction}>
      <input name="name" required />
      <button type="submit" disabled={isPending}>
        {isPending ? "Creating..." : "Create Tool"}
      </button>
    </form>
  );
}
```

```tsx
// ✅ Complex mutation with multiple DAL calls
export async function createRentalRequestAction(
  prevState: any,
  formData: FormData,
) {
  const toolId = formData.get("toolId") as string;
  const startDate = formData.get("startDate") as string;
  const endDate = formData.get("endDate") as string;

  const result = await tryCatch(
    async () => {
      // Check tool availability
      const tool = await ToolDAL.getById(toolId);
      if (!tool || tool.status !== "active") {
        throw new Error("Tool not available");
      }

      // Create rental request
      const rental = await RentalDAL.create({
        toolId,
        startDate: new Date(startDate),
        endDate: new Date(endDate),
      });

      // Send notification to tool owner
      await NotificationDAL.create({
        userId: tool.ownerId,
        type: "rental_request",
        data: { rentalId: rental.id, toolId },
      });

      return rental;
    },
    (error) => {
      console.error("Rental request failed:", error);
      return { success: false, error: error.message };
    },
  );

  if (result.success) {
    revalidatePath("/dashboard/rentals");
    return { success: true, rentalId: result.data.id };
  }

  return { success: false, error: result.error };
}
```

```tsx
// ✅ Error handling patterns
export async function updateToolAction(prevState: any, formData: FormData) {
  const toolId = formData.get("toolId") as string;
  const updates = Object.fromEntries(formData.entries());

  const result = await tryCatch(
    () => ToolDAL.update(toolId, updates),
    (error) => {
      if (error instanceof UnauthorizedError) {
        return {
          success: false,
          error: "You don't have permission to edit this tool",
        };
      }
      if (error instanceof DatabaseError) {
        return { success: false, error: "Database error occurred" };
      }
      return { success: false, error: "An unexpected error occurred" };
    },
  );

  if (result.success) {
    revalidatePath(`/dashboard/tools/${toolId}`);
    return { success: true };
  }

  return { success: false, error: result.error };
}
```

## General Rules

- Always prefer modern React patterns over legacy approaches
- Prioritize user experience with immediate feedback and proper loading states
- Handle errors gracefully with user-friendly messages
- Use TypeScript for better development experience and error catching
- Keep components focused and single-responsibility
- Test optimistic updates with network failures to ensure proper fallbacks

- Use React's built-in state management when possible
- Avoid unnecessary global state
- Colocate state with the components that use it
- Use React Context for theme and authentication state

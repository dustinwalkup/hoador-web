// src/app/dashboard/explore/_components/explore-page-content.tsx
"use client";

import { useToolFilters } from "@/lib/hooks/use-url-state";
import { useSearchTools } from "@/lib/hooks/use-tools";

export function ExplorePageContent() {
  // URL state management
  const { state: filters, updateState: updateFilters } = useToolFilters();

  // React Query with URL-based filters
  const { data, fetchNextPage, hasNextPage, isLoading } = useSearchTools(
    filters,
    userId,
  );

  // Infinite scroll trigger
  const loadMoreRef = useInfiniteScroll(
    fetchNextPage,
    hasNextPage,
    isFetchingNextPage,
  );

  // Flatten data from all pages
  const allTools = useMemo(() => {
    return data?.pages?.flatMap((page) => page.data) || [];
  }, [data]);

  // Instant filter changes - URL updates trigger React Query refetch
  const handleFilterChange = (newFilters: Partial<ToolSearchFilters>) => {
    updateFilters(newFilters); // URL updates, React Query refetches with cache
  };

  return (
    <div>
      <ExplorePageFilters
        filters={filters}
        onFiltersChange={handleFilterChange}
      />
      <div className="grid gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
        {allTools.map((tool) => (
          <ToolCard
            key={tool.id}
            {...tool}
            onMouseEnter={() => prefetchTool(tool.id)} // Prefetch on hover
          />
        ))}
      </div>

      {/* Infinite scroll trigger */}
      {hasNextPage && (
        <div ref={loadMoreRef} className="flex justify-center py-4">
          {isFetchingNextPage && (
            <Loader2 className="h-6 w-6 animate-spin text-gray-400" />
          )}
        </div>
      )}
    </div>
  );
}

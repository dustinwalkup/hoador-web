### 2. Filter Component with URL Sync

```tsx
// src/app/dashboard/explore/_components/explore-page-filters.tsx
"use client";

import { useSearchParams, useRouter, usePathname } from "next/navigation";
import { useCallback, useMemo } from "react";
import { debounce } from "lodash";

interface ExplorePageFiltersProps {
  filters: ToolSearchFilters;
  onFiltersChange: (filters: Partial<ToolSearchFilters>) => void;
}

export function ExplorePageFilters({
  filters,
  onFiltersChange,
}: ExplorePageFiltersProps) {
  const router = useRouter();
  const pathname = usePathname();
  const searchParams = useSearchParams();

  // Debounced search to avoid API spam
  const debouncedSearch = useMemo(
    () =>
      debounce((query: string) => {
        onFiltersChange({ query });
      }, 300),
    [onFiltersChange],
  );

  const handleSearchChange = (query: string) => {
    // Update local state immediately for instant feedback
    setLocalQuery(query);
    // Debounce URL update to avoid API spam
    debouncedSearch(query);
  };

  const handleCategoryChange = (categoryId: string) => {
    onFiltersChange({ categoryId });
  };

  const handlePriceRangeChange = (minPrice: number, maxPrice: number) => {
    onFiltersChange({ minPrice, maxPrice });
  };

  const handleSortChange = (sortBy: string, sortOrder: "asc" | "desc") => {
    onFiltersChange({ sortBy, sortOrder });
  };

  return (
    <div className="space-y-4">
      {/* Search input with debouncing */}
      <Input
        placeholder="Search tools..."
        value={filters.query}
        onChange={(e) => handleSearchChange(e.target.value)}
      />

      {/* Category filter */}
      <Select value={filters.categoryId} onValueChange={handleCategoryChange}>
        <SelectTrigger>
          <SelectValue placeholder="All Categories" />
        </SelectTrigger>
        <SelectContent>
          {categories.map((category) => (
            <SelectItem key={category.id} value={category.id}>
              {category.name}
            </SelectItem>
          ))}
        </SelectContent>
      </Select>

      {/* Price range slider */}
      <div>
        <Label>Price Range</Label>
        <Slider
          value={[filters.minPrice || 0, filters.maxPrice || 100]}
          onValueChange={([min, max]) => handlePriceRangeChange(min, max)}
          max={100}
          step={5}
        />
      </div>

      {/* Sort options */}
      <div className="flex gap-2">
        <Select
          value={filters.sortBy}
          onValueChange={(value) => handleSortChange(value, filters.sortOrder)}
        >
          <SelectTrigger>
            <SelectValue />
          </SelectTrigger>
          <SelectContent>
            <SelectItem value="newest">Newest</SelectItem>
            <SelectItem value="price">Price</SelectItem>
            <SelectItem value="rating">Rating</SelectItem>
            <SelectItem value="distance">Distance</SelectItem>
          </SelectContent>
        </Select>

        <Button
          variant="outline"
          size="icon"
          onClick={() =>
            handleSortChange(
              filters.sortBy,
              filters.sortOrder === "asc" ? "desc" : "asc",
            )
          }
        >
          {filters.sortOrder === "asc" ? (
            <ArrowUp className="h-4 w-4" />
          ) : (
            <ArrowDown className="h-4 w-4" />
          )}
        </Button>
      </div>
    </div>
  );
}
```


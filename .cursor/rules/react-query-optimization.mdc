// Support browser back/forward with URL state
export function useURLStateWithHistory<T>() {
  const { state, updateState } = useURLState<T>();

  // Listen for browser back/forward
  useEffect(() => {
    const handlePopState = () => {
      // URL changed via browser navigation
      // React Query will automatically refetch with new URL
    };

    window.addEventListener("popstate", handlePopState);
    return () => window.removeEventListener("popstate", handlePopState);
  }, []);

  return { state, updateState };
}
```


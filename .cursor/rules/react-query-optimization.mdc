export function useUserTools(
  filters: GarageToolFilters,
  status: "active" | "inactive" | "archived",
  page: number = 1,
) {
  return useQuery({
    queryKey: ["user-tools", filters, status, page],
    queryFn: async () => {
      const response = await fetch(
        `/api/tools/user?${new URLSearchParams({
          ...filters,
          status,
          page: page.toString(),
          limit: "12",
        })}`,
      );
      if (!response.ok) throw new Error("Failed to fetch user tools");
      const data = await response.json();
      return data;
    },
    staleTime: 1 * 60 * 1000, // 1 minute
  });
}

diff --git a/src/db/seeds/__tests__/reference-seeds.integration.test.ts b/src/db/seeds/__tests__/reference-seeds.integration.test.ts
new file mode 100644
index 0000000..873f77b
--- /dev/null
+++ b/src/db/seeds/__tests__/reference-seeds.integration.test.ts
@@ -0,0 +1,77 @@
+import { spawnSync } from "node:child_process";
+import { describe, it, expect, beforeEach } from "vitest";
+import { sql } from "drizzle-orm";
+import { db } from "@/db/db-e2e";
+
+/**
+ * R-DB-02: after `db:migrate` on a fresh environment, these three scripts are
+ * the whole reference-data bootstrap (src/db/migrations/README.md). Each must
+ * work on empty tables and be safe to run again.
+ *
+ * The scripts open their own pool through `db-seed.ts`, which loads
+ * `.env.local` but doesn't override a DATABASE_URL that's already set. The
+ * guard below makes sure that's the local test database, never staging.
+ */
+const SEEDS = [
+  {
+    file: "src/db/seeds/listing-categories.seed.ts",
+    table: "listing_categories",
+  },
+  {
+    file: "src/db/seeds/service-categories.seed.ts",
+    table: "service_listing_categories",
+  },
+  { file: "src/db/seeds/communities-real.seed.ts", table: "communities" },
+] as const;
+
+function runSeed(file: string) {
+  const url = process.env.DATABASE_URL ?? "";
+  if (!/@(localhost|127\.0\.0\.1)[:/]/.test(url)) {
+    throw new Error("Refusing to run a seed script against a non-local DB");
+  }
+  return spawnSync("bunx", ["tsx", file], {
+    env: { ...process.env, DATABASE_URL: url },
+    encoding: "utf-8",
+    timeout: 60_000,
+  });
+}
+
+async function countRows(table: string): Promise<number> {
+  const { rows } = await db.execute(
+    sql.raw(`SELECT count(*)::int AS n FROM ${table}`),
+  );
+  return (rows[0] as { n: number }).n;
+}
+
+describe("reference seed scripts (fresh-environment bootstrap)", () => {
+  beforeEach(async () => {
+    await db.execute(
+      sql.raw(
+        "TRUNCATE TABLE listing_categories, service_listing_categories, communities, community_networks RESTART IDENTITY CASCADE",
+      ),
+    );
+  });
+
+  it.each(SEEDS)(
+    "$file fills an empty table and is a no-op the second time",
+    async ({ file, table }) => {
+      const first = runSeed(file);
+      expect(first.status, first.stderr).toBe(0);
+      const afterFirst = await countRows(table);
+      expect(afterFirst).toBeGreaterThan(0);
+
+      const second = runSeed(file);
+      expect(second.status, second.stderr).toBe(0);
+      expect(await countRows(table)).toBe(afterFirst);
+    },
+    120_000,
+  );
+
+  it("communities-real seeds only the KC Metro network", async () => {
+    expect(runSeed("src/db/seeds/communities-real.seed.ts").status).toBe(0);
+    const { rows } = await db.execute(
+      sql`SELECT slug FROM community_networks ORDER BY slug`,
+    );
+    expect(rows).toEqual([{ slug: "kansas-city-metro" }]);
+  }, 60_000);
+});
diff --git a/src/db/seeds/communities-real.seed.ts b/src/db/seeds/communities-real.seed.ts
new file mode 100644
index 0000000..8a83942
--- /dev/null
+++ b/src/db/seeds/communities-real.seed.ts
@@ -0,0 +1,70 @@
+import "dotenv/config";
+import { and, eq } from "drizzle-orm";
+import { db } from "../db-seed";
+import { communities, communityNetworks } from "../schemas/communities.schema";
+import { KC_METRO_COMMUNITIES, KC_METRO_SLUG } from "./communities.seed";
+
+/**
+ * Real reference data for a fresh environment: the Kansas City Metro network
+ * and its communities, nothing else (no test network, memberships or
+ * visibility rows). Idempotent, so safe to re-run. Run after `db:migrate`;
+ * see src/db/migrations/README.md.
+ */
+async function main(): Promise<void> {
+  console.log("🏘️ Seeding Kansas City Metro network and communities...");
+
+  await db
+    .insert(communityNetworks)
+    .values({
+      name: "Kansas City Metro",
+      slug: KC_METRO_SLUG,
+      description:
+        "Connected neighborhood marketplace network across the Kansas City metro area.",
+    })
+    .onConflictDoNothing({ target: communityNetworks.slug });
+
+  const [network] = await db
+    .select({ id: communityNetworks.id })
+    .from(communityNetworks)
+    .where(eq(communityNetworks.slug, KC_METRO_SLUG))
+    .limit(1);
+  if (!network) {
+    throw new Error(`Network ${KC_METRO_SLUG} missing after insert`);
+  }
+
+  // communities.name has no unique index, so match on (name, network) by hand.
+  let inserted = 0;
+  for (const c of KC_METRO_COMMUNITIES) {
+    const [existing] = await db
+      .select({ id: communities.id })
+      .from(communities)
+      .where(
+        and(
+          eq(communities.name, c.name),
+          eq(communities.networkId, network.id),
+        ),
+      )
+      .limit(1);
+    if (existing) continue;
+
+    await db.insert(communities).values({
+      name: c.name,
+      city: c.city,
+      state: c.state,
+      zip: c.zip,
+      networkId: network.id,
+    });
+    inserted++;
+  }
+
+  console.log(
+    `✅ ${inserted} inserted, ${KC_METRO_COMMUNITIES.length - inserted} already present`,
+  );
+}
+
+main()
+  .then(() => process.exit(0))
+  .catch((error) => {
+    console.error("❌ Failed seeding KC Metro communities:", error);
+    process.exit(1);
+  });

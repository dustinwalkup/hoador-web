diff --git a/src/test/integration/baseline-sql.ts b/src/test/integration/baseline-sql.ts
new file mode 100644
index 0000000..bb05fae
--- /dev/null
+++ b/src/test/integration/baseline-sql.ts
@@ -0,0 +1,30 @@
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import { sql } from "drizzle-orm";
+import { db } from "@/db/db-e2e";
+
+const MIGRATIONS_DIR = join(process.cwd(), "src/db/migrations");
+
+/**
+ * The baseline's custom migration (R-DB-02): `btree_gist` plus the
+ * `rental_requests_no_overlap` exclusion constraint, and the `system` user.
+ * `db:push:e2e` creates neither, so tests that need them run this file. It's
+ * idempotent. Found through the journal, so a later re-squash that renumbers
+ * it doesn't break the path.
+ */
+function baselineCustomSql(): string {
+  const journal = JSON.parse(
+    readFileSync(join(MIGRATIONS_DIR, "meta/_journal.json"), "utf-8"),
+  ) as { entries: { tag: string }[] };
+  const entry = journal.entries.find((e) =>
+    e.tag.endsWith("_baseline_custom_objects"),
+  );
+  if (!entry) {
+    throw new Error("No *_baseline_custom_objects migration in the journal");
+  }
+  return readFileSync(join(MIGRATIONS_DIR, `${entry.tag}.sql`), "utf-8");
+}
+
+export async function applyBaselineCustomSql(): Promise<void> {
+  await db.execute(sql.raw(baselineCustomSql()));
+}
